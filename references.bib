@article{Boulouird2018,
   abstract = {Massive-MIMO systems are the emerging systems for the new generation 5G. Massive-MIMO systems have the particularity of increasing the performance of the system while providing a very large number of antennas to serve a very large number of users. However, the orthogonal pilot sequences which can be served are limited, then non-orthogonal pilot sequences are used to satisfy the requirements. These nonorthogonal pilot sequences in the adjacent cells overlap with each other; Consequently, they cause the problem of pilot contamination. This paper presents the problem of pilot contamination in the uplinks and the downlinks. The pilot contamination reduce the performance of the system where the identical pilot sequences interferes with each other and consequently an estimate is obtained contaminating channels of different user.},
   author = {Mohamed Boulouird and Abdelhamid Riadi and Moha M.Rabet Hassani},
   doi = {10.1109/EITECH.2017.8255299},
   isbn = {9781538615164},
   journal = {Proceedings of 2017 International Conference on Electrical and Information Technologies, ICEIT 2017},
   keywords = {5G Wireless Communication,Massive-MIMO systems,Multi-cell,Pilot Contamination},
   month = {1},
   pages = {1-4},
   publisher = {Institute of Electrical and Electronics Engineers Inc.},
   title = {Pilot contamination in multi-cell massive-MIMO systems in 5G wireless communications},
   volume = {2018-January},
   url = {https://ieeexplore.ieee.org/document/8255299},
   year = {2018}
}
@article{Bjornson2020,
   abstract = {Imagine a coverage area with many wireless access points that cooperate to jointly serve the users, instead of creating autonomous cells. Such a cell-free network operation can potentially resolve many of the interference issues that appear in current cellular networks. This ambition was previously called Network MIMO (multiple-input multiple-output) and has recently reappeared under the name Cell-Free Massive MIMO. The main challenge is to achieve the benefits of cell-free operation in a practically feasible way, with computational complexity and fronthaul requirements that are scalable to large networks with many users. We propose a new framework for scalable Cell-Free Massive MIMO systems by exploiting the dynamic cooperation cluster concept from the Network MIMO literature. We provide a novel algorithm for joint initial access, pilot assignment, and cluster formation that is proved to be scalable. Moreover, we adapt the standard channel estimation, precoding, and combining methods to become scalable. A new uplink and downlink duality is proved and used to heuristically design the precoding vectors on the basis of the combining vectors. Interestingly, the proposed scalable precoding and combining outperform conventional maximum ratio (MR) processing and also performs closely to the best unscalable alternatives.},
   author = {Emil Bjornson and Luca Sanguinetti},
   doi = {10.1109/TCOMM.2020.2987311},
   issn = {15580857},
   issue = {7},
   journal = {IEEE Transactions on Communications},
   keywords = {Cell-free massive MIMO,centralized and distributed algorithms,dynamic cooperation clustering,scalable implementation,uplink-downlink duality,user-centric networking},
   month = {7},
   pages = {4247-4261},
   publisher = {Institute of Electrical and Electronics Engineers Inc.},
   title = {Scalable Cell-Free Massive MIMO Systems},
   volume = {68},
   url = {http://arxiv.org/abs/1908.03119},
   year = {2020}
}
